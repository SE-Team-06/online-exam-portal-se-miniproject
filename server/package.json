{
  "name": "@online-exam-portal/server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "demo": "node src/demo.js",
    "test": "node --test --test-concurrency=1",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-lines=70",
    "check": "node --check src/index.js && node --check src/app.js && node --check src/ops/cli.js",
    "backup": "node src/ops/cli.js backup",
    "restore": "node src/ops/cli.js restore",
    "availability": "node src/ops/cli.js availability",
    "scale:load": "node src/ops/scale.js load",
    "scale:storage": "node src/ops/scale.js storage"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mongoose": "9.11.2",
    "nodemailer": "^10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "11.3.0",
    "supertest": "7.3.1"
  }
}
