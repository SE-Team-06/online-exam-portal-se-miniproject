MONGODB_URI=mongodb://127.0.0.1:27017/online_exam_portal
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
SMTP_URL=
MAIL_FROM="Online Exam Portal <no-reply@example.test>"
SESSION_INACTIVITY_MINUTES=30
# Set NODE_ENV=production and REQUIRE_HTTPS=true behind a TLS proxy (see docs/SECURITY_DEPLOYMENT.md)
NODE_ENV=development
REQUIRE_HTTPS=false
# Backups (docs/OPERATIONS.md): set BACKUP_DIR to enable the daily backup in the API server
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETAIN=7
