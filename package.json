{
  "name": "online-exam-portal",
  "private": true,
  "type": "module",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=22.12.0" },
  "devDependencies": { "concurrently": "10.0.6" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace client run dev",
    "demo": "concurrently -k -n api,web -c cyan,magenta \"npm:demo:api\" \"npm:dev:web\"",
    "demo:api": "npm --workspace server run demo",
    "test": "npm --workspace server test && npm --workspace client test",
    "build": "npm --workspace server run check && npm --workspace client run build"
  }
}
